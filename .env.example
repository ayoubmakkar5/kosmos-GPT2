# ---------------------------------------------------------------------------
# Kosmos Code — example environment file. Copy to `.env` and edit.
# `server.js` reads this file automatically on start (no dependencies).
# ---------------------------------------------------------------------------

# Password required to open the website  ← غيّرها!
APP_PASSWORD=Kosmos@2026

# Random long string used to sign session cookies (keep it secret & stable)
SESSION_SECRET=change-me-to-a-long-random-string

PORT=3000
HOST=0.0.0.0

# Real Qwen3 model (GGUF) + llama.cpp engine
MODEL_PATH=models/Qwen3-0.6B-Q4_K_M.gguf
MODEL_NAME=Qwen3-0.6B
MODEL_QUANT=Q4_K_M
CTX_SIZE=4096
LLAMA_SERVER_BIN=llama.cpp/build/bin/llama-server
LLAMA_PORT=8080
