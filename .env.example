# ─── Kosmos AI ───────────────────────────────────────────────────────────────
# Copy to .env and adjust, or export these before `npm start`.

# The password gate. Compared case-insensitively on purpose.
APP_PASSWORD=Kosmos@2026

# Where the app listens.
PORT=3000
HOST=0.0.0.0

# Model. Any LFM3 GGUF works; Q4_K_M is the recommended size/quality point.
MODEL_FILE=models/LFM3-1.7B-Q4_K_M.gguf
MODEL_NAME=LFM3-1.7B
MODEL_QUANT=Q4_K_M

# Runtime context window. Native is 262144, but 256K needs ~1.6 GB of KV cache.
# 8192 is a good default for CPU boxes; 32768 is comfortable on 8 GB.
CTX_SIZE=8192

# Engine tuning.
ENGINE_PORT=8081
ENGINE_THREADS=2
ENGINE_GPU_LAYERS=0
ENGINE_PARALLEL=1
# ENGINE_EXTRA_ARGS=--mlock

# Sessions.
SESSION_TTL_HOURS=720
LOGIN_MAX_ATTEMPTS=10

# Limits.
MAX_UPLOAD_BYTES=12582912
MAX_PROMPT_CHARS=120000

# Set to 1 for verbose llama.cpp logging.
# DEBUG=1
